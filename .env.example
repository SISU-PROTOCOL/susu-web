# susu-web — environment template
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
# SECURITY: every variable here is bundled into the browser. Only browser-safe
# values may appear in this file. Never add a service-role key, secret key,
# database password, or private key — `src/lib/env.ts` will refuse to start if
# it detects one.

# Public URL of this app (used for auth redirects).
VITE_APP_URL=http://localhost:5173

# Supabase project. The anon/publishable key is public by design and is protected
# by Row Level Security. It must never be the service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stellar network: local | testnet | mainnet
# Mainnet is out of scope until the Mainnet readiness gate is passed.
VITE_STELLAR_NETWORK=testnet
VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Deployed contract IDs (C... addresses are public). These are the Testnet
# deployments recorded in susu-contracts/docs/TESTNET.md. Mainnet IDs must never
# be mixed in.
VITE_FACTORY_CONTRACT_ID=CCC7KAX4V4GJD6FVG6GSYQ4I2D2B3CWEOQMIX6YM4QBGXTA6INCGRUYC
VITE_USDC_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# Block explorer base URL for the selected network.
VITE_EXPLORER_BASE_URL=https://stellar.expert/explorer/testnet
